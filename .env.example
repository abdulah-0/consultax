# Database Connection String (Supabase / PostgreSQL)
# Example: postgresql://postgres.xxxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres"

# JWT Secret for Session Hashing in the Admin Dashboard
JWT_SECRET="replace-with-a-secure-random-key"

# Transactional Email Provider API Key (e.g. Resend / SendGrid)
EMAIL_API_KEY=""

# Public contact email address configuration (PRD Section 8.3)
NEXT_PUBLIC_CONTACT_EMAIL="consultaxassociates@gmail.com"
